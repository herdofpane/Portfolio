---
---

<section id="hero" class="relative pt-36 pb-20 md:pt-44 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide">
          <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>En alternance chez Semware • Master MIASHS ICE-LD</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
          Bonjour, je suis <br/>
          <span class="gradient-text">Bradley Djedje</span>
        </h1>

        <p class="text-xl sm:text-2xl font-semibold text-cyan-400">
          Chef de Projets Informatique &amp; Développeur Full-Stack
        </p>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          Actuellement en <strong>Master MIASHS ICE-LD</strong> (Université de Toulouse) et <strong>en alternance chez Semware</strong>, je concilie expertise technique logicielle et méthodologie de pilotage de projet IT. Fort d'un <strong>BUT Informatique</strong> et d'expériences au <strong>CNRS</strong> et chez <strong>Egerine</strong>, je contribue à concevoir et livrer des solutions logicielles robustes et évolutives.
        </p>

        <!-- Highlights pills -->
        <div class="flex flex-wrap gap-3 pt-2">
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-slate-300">
            <svg class="size-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Toulouse &amp; Mobilité</span>
          </div>

          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-slate-300">
            <svg class="size-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
            <span>Permis B &amp; Véhiculé</span>
          </div>

          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-slate-300">
            <svg class="size-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <span>Anglais B2 (TOEIC)</span>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a 
            href="#projects" 
            class="px-6 py-3.5 rounded-full bg-gradient-to-r from-cyan-500 via-blue-600 to-purple-600 text-white font-semibold text-sm shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all flex items-center gap-2"
          >
            <span>Voir mes réalisations</span>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="#contact" 
            class="px-6 py-3.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold text-sm hover:-translate-y-0.5 transition-all"
          >
            Me contacter
          </a>

          <button 
            id="hero-copy-email-btn"
            class="size-12 rounded-full bg-white/5 hover:bg-cyan-500/10 border border-white/10 hover:border-cyan-500/40 flex items-center justify-center text-slate-300 hover:text-cyan-400 transition-all"
            title="Copier mon email"
            aria-label="Copier l'adresse email"
          >
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>

        <!-- Social Bar -->
        <div class="flex items-center gap-6 pt-6 border-t border-white/10 text-sm text-slate-400">
          <a href="https://linkedin.com/in/bradley-djedje" target="_blank" rel="noreferrer" class="hover:text-cyan-400 transition-colors flex items-center gap-2">
            <span>LinkedIn</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
          <a href="https://github.com/herdofpane" target="_blank" rel="noreferrer" class="hover:text-cyan-400 transition-colors flex items-center gap-2">
            <span>GitHub</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
          <a href="mailto:djedjebradley77@gmail.com" class="hover:text-cyan-400 transition-colors">
            djedjebradley77@gmail.com
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Profile Card -->
      <div class="lg:col-span-5">
        <div class="glass-card rounded-3xl p-6 sm:p-8 relative overflow-hidden border border-white/10 shadow-2xl shadow-cyan-500/10">
          <div class="flex items-center justify-between mb-6">
            <div class="size-16 rounded-2xl bg-gradient-to-tr from-cyan-500 to-purple-600 flex items-center justify-center text-2xl font-black text-white shadow-lg shadow-cyan-500/30">
              BD
            </div>
            <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">
              <span class="size-1.5 rounded-full bg-emerald-400"></span>
              <span>En poste @ Semware</span>
            </div>
          </div>

          <h2 class="text-2xl font-bold text-white">Bradley Djedje</h2>
          <p class="text-sm text-cyan-400 font-medium mb-6">Chef de Projets IT &amp; Développeur Full-Stack</p>

          <!-- 4 Stats Grid -->
          <div class="grid grid-cols-2 gap-3 mb-6">
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <span class="block text-2xl font-extrabold text-cyan-400">Semware</span>
              <span class="text-xs text-slate-400">Alternance en cours</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <span class="block text-2xl font-extrabold text-purple-400">3+</span>
              <span class="text-xs text-slate-400">Expériences (Semware, CNRS, Egerine)</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <span class="block text-2xl font-extrabold text-blue-400">Master</span>
              <span class="text-xs text-slate-400">MIASHS ICE-LD (En cours)</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white/5 border border-white/5">
              <span class="block text-2xl font-extrabold text-emerald-400">3</span>
              <span class="text-xs text-slate-400">Certifications Cloud &amp; Dev</span>
            </div>
          </div>

          <!-- JSON Snippet -->
          <div class="rounded-xl bg-black/60 border border-white/10 p-4 font-mono text-xs text-slate-300">
            <div class="flex items-center gap-1.5 pb-2 mb-2 border-b border-white/10 text-slate-500">
              <span class="size-2.5 rounded-full bg-rose-500"></span>
              <span class="size-2.5 rounded-full bg-amber-500"></span>
              <span class="size-2.5 rounded-full bg-emerald-500"></span>
              <span class="ml-2 text-xs">profil.json</span>
            </div>
            <p><span class="text-cyan-400">"poste"</span>: <span class="text-emerald-300">"Alternant Semware"</span>,</p>
            <p><span class="text-cyan-400">"formation"</span>: <span class="text-emerald-300">"Master MIASHS ICE-LD"</span>,</p>
            <p><span class="text-cyan-400">"role"</span>: <span class="text-emerald-300">"Chef de Projets &amp; Full-Stack"</span>,</p>
            <p><span class="text-cyan-400">"stack"</span>: [<span class="text-amber-300">"Django"</span>, <span class="text-amber-300">"Angular"</span>, <span class="text-amber-300">"Spring Boot"</span>]</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-email-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('djedjebradley77@gmail.com');
        window.showToast?.('Email copié dans le presse-papier !');
      } catch (e) {
        window.showToast?.('djedjebradley77@gmail.com');
      }
    });
  }
</script>
