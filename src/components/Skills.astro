---
const skillCategories = [
  {
    title: 'Développement Full-Stack',
    desc: 'Frameworks modernes & architectures logicielles',
    badgeColor: 'text-blue-400 bg-blue-500/10 border-blue-500/20',
    skills: [
      { name: 'Python (Django)', highlight: true },
      { name: 'JavaScript (Angular)', highlight: true },
      { name: 'Java (Spring Boot)', highlight: true },
      { name: 'PHP (Symfony)', highlight: false },
      { name: 'HTML5 / CSS3', highlight: false },
      { name: 'Tailwind CSS', highlight: false },
      { name: 'RESTful APIs', highlight: false }
    ]
  },
  {
    title: 'Bases de Données & Data',
    desc: 'Modélisation, persistance et analyses',
    badgeColor: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
    skills: [
      { name: 'PostgreSQL', highlight: true },
      { name: 'MySQL', highlight: false },
      { name: 'Oracle SQL', highlight: false },
      { name: 'NoSQL (MongoDB)', highlight: true },
      { name: 'Databricks Fundamentals', highlight: true },
      { name: 'Optimisation de requêtes', highlight: false }
    ]
  },
  {
    title: 'DevOps, Système & Outils',
    desc: 'Conteneurs, serveurs et outillage de test',
    badgeColor: 'text-amber-400 bg-amber-500/10 border-amber-500/20',
    skills: [
      { name: 'Docker', highlight: true },
      { name: 'Nginx', highlight: false },
      { name: 'Linux / Bash', highlight: true },
      { name: 'Git / GitHub / GitLab', highlight: false },
      { name: 'Postman (API Testing)', highlight: true },
      { name: 'Déploiement Serveur', highlight: false }
    ]
  },
  {
    title: 'Méthodologie & Soft Skills',
    desc: 'Gestion de projet, reporting et communication',
    badgeColor: 'text-purple-400 bg-purple-500/10 border-purple-500/20',
    skills: [
      { name: 'Scrum / Agile', highlight: true },
      { name: 'PowerBI (Reporting)', highlight: true },
      { name: 'Documentation & Passation', highlight: false },
      { name: 'Collaboration R&D', highlight: false },
      { name: 'Anglais (B2 - TOEIC)', highlight: true },
      { name: 'Français (Natif)', highlight: false }
    ]
  }
];
---

<section id="skills" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <span class="text-cyan-400 font-bold tracking-widest text-xs uppercase">Stack Technique</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Compétences Éprouvées</h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Un ensemble cohérent de technologies acquises sur le terrain (CNRS, Egerine), en BUT et certifiées par des acteurs majeurs.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillCategories.map((category) => (
        <div class="glass-card rounded-2xl p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-white">{category.title}</h3>
              <span class={`text-xs px-2.5 py-1 rounded-full border font-semibold ${category.badgeColor}`}>
                Expertise
              </span>
            </div>
            <p class="text-xs text-slate-400 mb-6">{category.desc}</p>
            
            <div class="flex flex-wrap gap-2.5">
              {category.skills.map((skill) => (
                <span 
                  class={`text-xs font-semibold px-3.5 py-1.5 rounded-full border transition-all ${
                    skill.highlight 
                      ? 'bg-cyan-500/10 border-cyan-500/40 text-cyan-300 shadow-sm shadow-cyan-500/10' 
                      : 'bg-white/5 border-white/10 text-slate-300 hover:border-slate-500'
                  }`}
                >
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
