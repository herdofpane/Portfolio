---
const projects = [
  {
    id: 'cnrs',
    title: 'Observatoire Robotisé',
    subtitle: 'CNRS • Laboratoire de Recherche',
    category: 'Backend & Robotique',
    summary: "Refonte d'architecture Django et automatisation de flux de données pour le pilotage d'un observatoire robotisé.",
    stack: ['Python', 'Django', 'Systèmes Robotisés', 'Automatisation', 'Linux'],
    gradient: 'from-cyan-500/20 to-blue-600/20'
  },
  {
    id: 'egerine',
    title: 'Plateforme Web & API Sécurisée',
    subtitle: 'Egerine • Solution Entreprise',
    category: 'Full-Stack & DevOps',
    summary: "Développement Front-End Angular, conception d'APIs REST sécurisées, déploiement serveur et documentation complète.",
    stack: ['Angular', 'TypeScript', 'REST API', 'Linux/Nginx', 'PostgreSQL'],
    gradient: 'from-blue-500/20 to-purple-600/20'
  },
  {
    id: 'data',
    title: 'Pipeline Data & Analytics Lakehouse',
    subtitle: 'Projet Personnel & Certifications',
    category: 'Data Engineering & Cloud',
    summary: 'Mise en pratique du modèle Lakehouse Databricks avec pipelines de données Python et tableaux de bord PowerBI.',
    stack: ['Databricks', 'Python', 'PostgreSQL', 'PowerBI', 'HackerRank'],
    gradient: 'from-purple-500/20 to-pink-600/20'
  },
  {
    id: 'springboot',
    title: 'Services Distribués & Gestion Agile',
    subtitle: 'BUT Informatique • Projet de Synthèse',
    category: 'Architecture Distribuée',
    summary: "Application multi-services avec Java Spring Boot, MongoDB et Symfony, développée en équipe avec la méthode Scrum.",
    stack: ['Java Spring Boot', 'Symfony', 'Docker', 'MongoDB', 'Scrum'],
    gradient: 'from-emerald-500/20 to-cyan-600/20'
  }
];
---

<section id="projects" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <span class="text-cyan-400 font-bold tracking-widest text-xs uppercase">Portfolio &amp; Réalisations</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Projets Marquants</h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Une sélection de réalisations illustrant la conduite de projets techniques et le développement full-stack.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((p) => (
        <div class="glass-card rounded-3xl overflow-hidden flex flex-col justify-between group border-white/10 hover:border-cyan-500/40">
          <div>
            <!-- Banner -->
            <div class={`h-40 bg-linear-to-br ${p.gradient} p-6 flex items-start justify-between border-b border-white/10`}>
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-black/40 backdrop-blur-md text-white border border-white/10">
                {p.category}
              </span>
              <div class="size-10 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
            </div>

            <!-- Body -->
            <div class="p-8">
              <h3 class="text-2xl font-bold text-white mb-1 group-hover:text-cyan-300 transition-colors">
                {p.title}
              </h3>
              <p class="text-xs font-semibold text-cyan-400 mb-4">{p.subtitle}</p>
              
              <p class="text-sm text-slate-300 leading-relaxed mb-6">{p.summary}</p>

              <div class="flex flex-wrap gap-2 mb-6">
                {p.stack.map((s) => (
                  <span class="text-xs px-2.5 py-1 rounded-full bg-white/5 border border-white/5 text-slate-300 font-medium">
                    {s}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="px-8 pb-8 pt-4 border-t border-white/10 flex items-center justify-between">
            <button 
              class="open-project-btn text-xs font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-2 cursor-pointer transition-all"
              data-project={p.id}
            >
              <span>Détails &amp; Missions</span>
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
