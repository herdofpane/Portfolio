---
---

<section id="contact" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <span class="text-cyan-400 font-bold tracking-widest text-xs uppercase">Disponibilité</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Échangeons sur votre opportunité</h2>
      <p class="text-slate-400 text-base sm:text-lg">
        À la recherche active d'une alternance de 12 ou 24 mois pour la rentrée de Septembre 2026.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contact Info Cards -->
      <div class="lg:col-span-5 space-y-6">
        <div class="glass-card rounded-3xl p-8 border-white/10 space-y-6">
          <h3 class="text-xl font-bold text-white">Coordonnées Directes</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            N'hésitez pas à me joindre pour planifier un entretien ou échanger sur vos besoins techniques et d'organisation.
          </p>

          <div class="space-y-4">
            <!-- Email -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/5">
              <div class="space-y-0.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Email</span>
                <a href="mailto:djedjebradley77@gmail.com" class="block text-sm font-semibold text-slate-200 hover:text-cyan-400">
                  djedjebradley77@gmail.com
                </a>
              </div>
              <button 
                class="copy-info-btn size-9 rounded-lg bg-white/5 hover:bg-cyan-500/10 text-slate-400 hover:text-cyan-400 flex items-center justify-center transition-all cursor-pointer"
                data-copy="djedjebradley77@gmail.com"
                data-label="Email"
                title="Copier l'email"
              >
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>

            <!-- Phone -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/5">
              <div class="space-y-0.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Téléphone</span>
                <a href="tel:+33783033992" class="block text-sm font-semibold text-slate-200 hover:text-cyan-400">
                  +33 07 83 03 39 92
                </a>
              </div>
              <button 
                class="copy-info-btn size-9 rounded-lg bg-white/5 hover:bg-cyan-500/10 text-slate-400 hover:text-cyan-400 flex items-center justify-center transition-all cursor-pointer"
                data-copy="+330783033992"
                data-label="Téléphone"
                title="Copier le numéro"
              >
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>

            <!-- Location -->
            <div class="p-4 rounded-xl bg-white/5 border border-white/5 space-y-0.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Localisation</span>
              <p class="text-sm font-semibold text-slate-200">
                Toulouse, France (Permis B, véhiculé &amp; mobile)
              </p>
            </div>
          </div>

          <!-- Social Links -->
          <div class="pt-4 border-t border-white/10 flex gap-4">
            <a 
              href="https://linkedin.com/in/bradley-djedje" 
              target="_blank" 
              rel="noreferrer" 
              class="flex-1 py-2.5 rounded-xl bg-white/5 hover:bg-cyan-500/10 border border-white/10 hover:border-cyan-500/30 text-center text-xs font-bold text-slate-300 hover:text-cyan-400 transition-all"
            >
              LinkedIn
            </a>
            <a 
              href="https://github.com/herdofpane" 
              target="_blank" 
              rel="noreferrer" 
              class="flex-1 py-2.5 rounded-xl bg-white/5 hover:bg-cyan-500/10 border border-white/10 hover:border-cyan-500/30 text-center text-xs font-bold text-slate-300 hover:text-cyan-400 transition-all"
            >
              GitHub
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-7">
        <div class="glass-card rounded-3xl p-8 sm:p-10 border-white/10">
          <h3 class="text-xl font-bold text-white mb-2">Envoyer un message</h3>
          <p class="text-xs sm:text-sm text-slate-400 mb-8">
            Remplissez ce formulaire pour initier un échange direct par email.
          </p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="contact-name" class="text-xs font-semibold text-slate-300">Votre Nom / Entreprise *</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  placeholder="Ex: Marie Dupont (Entreprise XYZ)" 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-400 transition-colors"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-email" class="text-xs font-semibold text-slate-300">Votre Email *</label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  required 
                  placeholder="nom@entreprise.com" 
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-400 transition-colors"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="contact-subject" class="text-xs font-semibold text-slate-300">Objet de l'échange *</label>
              <select 
                id="contact-subject" 
                name="subject" 
                required 
                class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-white/10 text-white text-sm focus:outline-none focus:border-cyan-400 transition-colors"
              >
                <option value="Échange professionnel & Réseau">Échange professionnel &amp; Réseau</option>
                <option value="Opportunité professionnelle / Collaboration">Opportunité professionnelle / Collaboration</option>
                <option value="Autre demande">Autre demande</option>
              </select>
            </div>

            <div class="space-y-1.5">
              <label for="contact-message" class="text-xs font-semibold text-slate-300">Votre Message *</label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Bonjour Bradley, je vous contacte pour échanger au sujet de..." 
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-400 transition-colors"
              ></textarea>
            </div>

            <button 
              type="submit" 
              id="contact-submit-btn" 
              class="w-full py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold text-sm shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/40 transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Envoyer le message</span>
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy button handlers
  const copyBtns = document.querySelectorAll('.copy-info-btn');
  copyBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      const label = btn.getAttribute('data-label') || 'Information';
      if (!text) return;

      try {
        await navigator.clipboard.writeText(text);
        window.showToast?.(`${label} copié dans le presse-papier !`);
      } catch (e) {
        window.showToast?.(text);
      }
    });
  });

  // Contact form submission
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit-btn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    const name = (form.elements.namedItem('name') as HTMLInputElement).value;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const subject = (form.elements.namedItem('subject') as HTMLSelectElement).value;
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value;

    const mailtoSubject = encodeURIComponent(`[Portfolio] ${subject} - ${name}`);
    const mailtoBody = encodeURIComponent(`Bonjour Bradley,\n\n${message}\n\n---\nExpéditeur : ${name} (${email})`);

    window.location.href = `mailto:djedjebradley77@gmail.com?subject=${mailtoSubject}&body=${mailtoBody}`;
    window.showToast?.('Client de messagerie ouvert avec votre message !');
    form.reset();
  });
</script>
